      "height": 887
    },
    {
      "image": "res://assets/story_comics/master_delivery_20261004/image_206d504c522c70e7.png",
      "text": "但前方已经有人在攫取胜利的果实，你决定狠狠撅取撅走果实的家伙",
      "width": 1774,
      "height": 887
    }
  ],
  "mode1_stage2_opening": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_02_intro.png",
      "text": "黏糊糊的第一幕结束了。\n格温加入小队，芙宁娜坚持把下一场战斗叫作「巡回演出」。"
    }
  ],
  "mode1_stage2_won": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_02_outro.png",
      "text": "炮声暂时停下。\n裂隙深处传来狼嚎，以及一尊石像非常不礼貌的落地声。"
    }
  ],
  "mode1_stage3_opening": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_03_intro.png",
      "text": "三章冒险的最后一道防线。\n羊与狼等在门口，天空中的影子却比它们加起来还大。"
    }
  ],
  "mode1_stage3_won": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_03_outro.png",
      "text": "你以为胜利能解决一切。\n一位裁缝看了看你的披风，认为事情远没有结束。"
    }
  ],
  "mode1_stage4_opening": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_04_intro.png",
      "text": "苍穹交叉口的风，把路牌吹成了风向标。\n你遇见一位正准备让天气接受体检的人。"
    }
  ],
  "mode1_stage4_won": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_04_outro.png",
      "text": "风终于停下来休息。\n你们决定尊重这个难得的好榜样。"
    }
  ],
  "mode1_stage5_opening": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_05_intro.png",
      "text": "你走进熔炉回旋庭。\n温度很热情，待遇很灼伤，唯一的好消息是裁缝还没下班。"
    }
  ],
  "mode1_stage5_won": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_05_outro.png",
      "text": "熔炉熄灭了，你成功保住了披风。\n家庭教师宣布：休息时间结束，现在开始总结。"
    }
  ],
  "mode1_stage6_opening": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_06_intro.png",
      "text": "钟楼的时间卡在开场前三秒。\n演员想要谢幕，报表却想永远加班。"
    }
  ],
  "mode1_stage6_won": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_06_outro.png",
      "text": "时钟恢复了转动。\n重复的昨天被丢进废纸篓，今天终于可以只过一遍。"
    }
  ],
  "mode1_stage7_opening": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_07_intro.png",
      "text": "永冻岔路把每一步都变成了一次抽奖。\n你决定先找个愿意扶你的人，再考虑假装从容。"
    }
  ],
  "mode1_stage7_won": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_07_outro.png",
      "text": "你们穿过冰原。\n离最后一道门越近，计划里的“我们”就写得越大。"
    }
  ],
  "mode1_stage8_opening": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_08_intro.png",
      "text": "蚀日围城就在眼前。\n最后的门承诺给出答案，却对回程路线保持沉默。"
    }
  ],
  "mode1_final_won": [
    {
      "image": "res://assets/story_comics/illustrations_v2/stage_03_outro.png",
      "text": "水晶仍然亮着，三个人也都还在。\n第三章完成。下一次冒险，可以先从好好睡一觉开始。"
    }
  ]
}
