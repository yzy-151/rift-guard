  "mode1_won": {
    "runtime_key": "mode1_won",
    "comics": [
      {
        "image": "res://assets/story_comics/master_delivery_20261004/image_c8a78d3bcaf9f0ff.png",
        "text": "终于，你战胜了黏糊糊的怪物，以免触发不妙的战败动画",
        "width": 1774,
        "height": 887
      },
      {
        "image": "res://assets/story_comics/master_delivery_20261004/image_206d504c522c70e7.png",
        "text": "但前方已经有人在攫取胜利的果实，你决定狠狠撅取撅走果实的家伙",
        "width": 1774,
        "height": 887
      }
    ],
    "nodes": [
      {
        "id": "n_mutx6u50_9jzk3",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "嗯？有黄毛",
        "next": "n_muty7h17_n5pa3"
      },
      {
        "id": "n_muty7h17_n5pa3",
        "type": "choice",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "我正好缺一个射手，你是伊泽瑞尔？伊？泽？瑞？尔？",
        "options": [
          {
            "text": "叽里咕噜说什么呢，跟我肘",
            "next": "n_mutya5su_z2m2m"
          },
          {
            "text": "是的我是探险家，也叫旅行者",
            "next": "n_mutyeq1w_dfdvv"
          }
        ]
      },
      {
        "id": "n_mutya5su_z2m2m",
        "type": "line",
        "speaker": "格温",
        "expression": "害羞",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_害羞_原画风重绘.png",
        "text": "走就走",
        "next": "n_mutye0z4_4nxvl"
      },
      {
        "id": "n_mutye0z4_4nxvl",
        "type": "ending",
        "status": "success",
        "unlock_character": "hero_13",
        "note": "格温加入队伍",
        "comics": []
      },
      {
        "id": "n_mutyeq1w_dfdvv",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "好的开拓者，我申请加入队伍",
        "next": "n_mutye0z4_4nxvl"
      }
    ],
    "start": "n_mutx6u50_9jzk3"
  },
