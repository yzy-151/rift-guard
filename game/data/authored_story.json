  "mode1_stage2_opening": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "「赤潮回廊，禁止喧哗」。那个扛炮的识字吗？",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "傲娇",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_傲娇_重绘_大腿根以上.png",
        "text": "这是第二幕的开场礼炮。只要我们走得够快，它就算欢送。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "它转过来了。现在算追悼。",
        "next": "l3"
      },
      {
        "id": "l3",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "先守住水晶。植物摆开，队伍散开……水壶放哪儿比较安全？",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "你真打算一路拎着它？",
        "options": [
          {
            "text": "当然。打完还得喝口热的。",
            "next": "reply0"
          },
          {
            "text": "放我身后，别让它抢前排。",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "行，那就一起保住它。我们这支队伍，总得有一个真正的输出是热水。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "好。坚果顶前面，水壶当后勤。别把这两个岗位弄反了。",
        "next": "done"
      },
      {
        "id": "done",
        "type": "ending",
        "status": "success",
        "note": "继续冒险",
        "comics": []
      }
    ]
  },
  "mode1_stage2_won": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "炮停了，水壶也还在。我们到底是在护送谁？",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "傲娇",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_傲娇_重绘_大腿根以上.png",
        "text": "当然是大家。只不过水壶从头到尾没有抱怨，是位优秀的队员。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "那给它发工资。前面的路通了——怎么还有狼叫？",
        "next": "l3"
      },
      {
        "id": "l3",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "一只羊、一只狼。旁边那尊石像刚才是不是动了一下？",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "出口就在它们后面。还走吗？",
        "options": [
          {
            "text": "都把水烧开了，总得喝完这趟。",
            "next": "reply0"
          },
          {
            "text": "走。听见狼叫，总比听见催稿强。",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "有道理，但别烫得上头。下一关重新选卡，先把队伍配好。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "你负责看路，我负责剪挡路的。至于那尊石像……先别站它正下面。",
        "next": "done"
      },
      {
        "id": "done",
        "type": "ending",
        "status": "success",
        "note": "继续冒险",
        "comics": []
      }
    ]
  },
  "mode1_stage3_opening": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "那只羊身边跟着狼。这地方连宠物关系都很复杂。",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "千珏。看见窄射线就让路，不要三个人排成一串给它练箭。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "你刚才说的石像呢？",
        "next": "l3"
      },
      {
        "id": "l3",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_惊讶_水滴瞳.png",
        "text": "加里奥……在上面！它和千珏是一伙的。地上亮起大范围预警，就赶紧挪开！",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "还有什么贵重物品需要我照看？",
        "options": [
          {
            "text": "我。活着的旅行者很贵。",
            "next": "reply0"
          },
          {
            "text": "水壶。它还没发过工资。",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "知道了。你先学会躲，我尽量不让你变成售后问题。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "行。你守水晶，我找机会剪它们，水壶继续保持情绪稳定。",
        "next": "done"
      },
      {
        "id": "done",
        "type": "ending",
        "status": "success",
        "note": "继续冒险",
        "comics": []
      }
    ]
  },
  "mode1_final_won": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "羊不射箭了，石像也落稳了。谁去问问它们让不让路？",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "不用问。门上写着：「后续区域暂未开放」。下面还有小字。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "「请勿用剪刀提前解锁」。这告示是不是刚贴的？",
        "next": "l3"
      },
      {
        "id": "l3",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "傲娇",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_傲娇_重绘_大腿根以上.png",
        "text": "那就暂时谢幕！三个人、一颗水晶、一壶热水，全部安全撤场。",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "后面的路先记着。现在回去，还是去无尽模式再打一会儿？",
        "options": [
          {
            "text": "回去喝茶。这壶水都等三关了。",
            "next": "reply0"
          },
          {
            "text": "牌都凑好了，我还没打够。",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "好。这回你找杯子，我看着门。别又一推就推到别的游戏里。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "格温",
