  "mode1_stage2_opening": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "前面写着「赤潮回廊」。地上这么红，是谁把番茄锅底打翻了？",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "傲娇",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_傲娇_重绘_大腿根以上.png",
        "text": "咳，这是本导演特意安排的第二幕！第一幕负责认识队友，第二幕负责让队友认识危险。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "所以那个举着炮、还在往我们这边走的大家伙，也是演员？",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "芙宁娜",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_惊讶_水滴瞳.png",
        "text": "它好像没有拿剧本。你有什么计划？",
        "options": [
          {
            "text": "先种植物，再让它认识一下我们的火力。",
            "next": "reply0"
          },
          {
            "text": "你负责鼓舞士气，我负责找掩体。",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_惊讶_水滴瞳.png",
        "text": "很好！舞台布置、灯光和炮火，一次解决。记得把水晶留在舞台上。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_惊讶_水滴瞳.png",
        "text": "批准。但掩体只能挡攻击，不能替你上班！带好格温，出发。",
        "next": "done"
      },
      {
        "id": "done",
        "type": "ending",
        "status": "success",
        "note": "三章试玩版剧情",
        "comics": []
      }
    ]
  },
  "mode1_stage2_won": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "炮停了。刚才那一串爆炸，是我们赢了，还是地图终于报废了？",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "傲娇",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_傲娇_重绘_大腿根以上.png",
        "text": "当然是谢幕烟花！另外，通往裂隙深处的路已经打开。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "有个戴面具的家伙站在门口，还有一团非常大的影子。看起来不像发通关奖励的。",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "第三幕的节目单只有四个字：双倍麻烦。",
        "options": [
          {
            "text": "那就让它们见识一下三人小队。",
            "next": "reply0"
          },
          {
            "text": "先检查卡牌，麻烦也得排队。",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "气势不错！这次别站在同一个预警圈里，团结不是一起挨打。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "严谨！下一关重新构筑，选好队伍再进门，别把好运当护甲。",
        "next": "done"
      },
      {
        "id": "done",
        "type": "ending",
        "status": "success",
        "note": "三章试玩版剧情",
        "comics": []
      }
    ]
  },
  "mode1_stage3_opening": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "羊、狼，还有一尊准备跳下来的石像。这是什么跨物种业主大会？",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "我宣布会议主题是：不要让它们拆掉水晶。千珏的箭会贯穿，看到射线先让路。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "那尊石像呢？",
        "next": "l3"
      },
      {
        "id": "l3",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_惊讶_水滴瞳.png",
        "text": "加里奥。它的入场礼仪是从天上砸下来，声音还特别大。千珏残血时尤其要看预警！",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "大范围的圈要躲，窄射线也要躲。你不会又准备靠脸接吧？",
        "options": [
          {
            "text": "分散站位，预警一亮就挪。",
            "next": "reply0"
          },
          {
            "text": "我的脸很贵，这次让它们空技能。",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "听着像个能活着回去的人。你盯水晶，我找机会下剪刀。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "你总算给自己的脸找到了正确用途：待在安全的地方。走吧！",
        "next": "done"
      },
      {
        "id": "done",
        "type": "ending",
        "status": "success",
        "note": "三章试玩版剧情",
        "comics": []
      }
    ]
  },
  "mode1_final_won": {
    "start": "l0",
    "nodes": [
      {
        "id": "l0",
        "type": "line",
        "speaker": "格温",
        "expression": "惊讶",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_惊讶_统一服装.png",
        "text": "它们终于不动了。我能把这场战斗写进裁缝的工伤申请吗？",
        "next": "l1"
      },
      {
        "id": "l1",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "傲娇",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_傲娇_重绘_大腿根以上.png",
        "text": "三幕演出，圆满落幕！感谢各位观众，感谢水晶，以及没有被踩坏的向日葵。",
        "next": "l2"
      },
      {
        "id": "l2",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "前面那扇门怎么贴着「施工中」？",
        "next": "l3"
      },
      {
        "id": "l3",
        "type": "line",
        "speaker": "芙宁娜",
        "expression": "思考",
        "portrait": "res://assets/helltaker/dialogue_portraits/芙宁娜_思考_重绘_大腿根以上.png",
        "text": "因为这次冒险先到这里。后续区域暂未开放——剧情可以留悬念，地板不能留窟窿。",
        "next": "pick"
      },
      {
        "id": "pick",
        "type": "choice",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "回家休息，还是带着这身卡牌去无尽模式再闹一场？",
        "options": [
          {
            "text": "先庆祝！我们真的守住了。",
            "next": "reply0"
          },
          {
            "text": "这一身构筑不能浪费，我还想打！",
            "next": "reply1"
          }
        ]
      },
      {
        "id": "reply0",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "好。我只剪庆祝用的彩带，不剪你的披风……今天先不剪。",
        "next": "done"
      },
      {
        "id": "reply1",
        "type": "line",
        "speaker": "格温",
        "expression": "羞恼",
        "portrait": "res://assets/helltaker/dialogue_portraits/格温_羞恼_统一服装.png",
        "text": "那就去无尽。怪物不会替你下班，记得在下一页选择携带构筑。",
        "next": "done"
      },
      {
        "id": "done",
        "type": "ending",
        "status": "success",
        "note": "三章试玩版剧情",
